{
  "name": "express-ts-drizzle-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready Express + TypeScript + Drizzle ORM boilerplate for AWS ECS/Fargate",
  "main": "dist/app.js",
  "scripts": {
    "dev": "node --require ts-node/register --watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed:rbac": "tsx src/modules/rbac/seeds/rbac.seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/instrumentation-express": "^0.42.0",
    "@opentelemetry/instrumentation-http": "^0.52.0",
    "@opentelemetry/instrumentation-pg": "^0.42.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@types/nodemailer": "^8.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "jose": "^6.2.3",
    "nodemailer": "^8.0.9",
    "pg": "^8.11.5",
    "rate-limit-redis": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.8.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@vitest/coverage-v8": "^2.0.5",
    "better-sqlite3": "^12.0.0",
    "drizzle-kit": "^0.21.4",
    "eslint": "^9.9.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
