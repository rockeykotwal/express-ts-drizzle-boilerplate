# ─── Application ──────────────────────────────────────────────────────────────
APP_PORT=3000
APP_NAME=YourApp
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=postgres
DB_PASS=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=express-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-minimum-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REQUIRE_EMAIL_VERIFICATION=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp                    # 'smtp' | 'resend'
EMAIL_FROM=noreply@yourapp.com
EMAIL_FROM_NAME=YourApp

# SMTP (used when EMAIL_PROVIDER=smtp)
# Local dev: use Mailpit (docker-compose up mailpit) — web UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
